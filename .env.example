# Copy to .env and edit. Every value here is optional -- the defaults in
# src/resume_tailor/core/config.py are the local-development settings.

# --- identity ---------------------------------------------------------------
RT_ENVIRONMENT=local          # local | docker | test | prod
RT_DEBUG=false

# --- logging ----------------------------------------------------------------
RT_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
RT_LOG_JSON=false             # true in Docker/prod

# --- http -------------------------------------------------------------------
RT_API_HOST=127.0.0.1
RT_API_PORT=8000
RT_API_BASE_URL=http://127.0.0.1:8000
RT_CORS_ORIGINS=http://localhost:8501
# RT_API_KEY=set-me-to-require-an-X-API-Key-header

# --- pdf engine -------------------------------------------------------------
# auto = probe tectonic, then pdflatex, then fall back to fake (tests only)
RT_PDF_ENGINE=auto
RT_COMPILE_TIMEOUT_S=60
RT_MAX_CONCURRENT_COMPILES=2

# --- input limits -----------------------------------------------------------
RT_MAX_BODY_BYTES=1048576
RT_MAX_JD_CHARS=100000
RT_MAX_SUMMARY_CHARS=5000
RT_MAX_SELECTED_PROJECTS=40
RT_MAX_PAGES_LIMIT=10

# --- rate limits ------------------------------------------------------------
RT_RATE_LIMIT_PER_MINUTE=120
RT_GENERATE_RATE_LIMIT_PER_MINUTE=12

# --- ui ---------------------------------------------------------------------
RT_UI_MODE=http               # http (talks to the API) | embedded (in-process)
